# Postgres connection string. Vercel adds this automatically when you connect Neon in the Storage tab.
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# The password you type to open the app
APP_PASSWORD="choose-a-good-password"

# Any long random text (e.g. from a password generator). Changing it logs out all devices.
AUTH_SECRET="replace-with-40-random-characters"
